# Configuración de Base de Datos PostgreSQL con extensión pgvector
# Aloja ambos esquemas: instituto (académico) e isft189 (bot RAG)
DATABASE_URL=postgresql+asyncpg://tpi:tpi123@localhost:55432/isft189

# Autenticación JWT (RBAC)
JWT_SECRET_KEY=cambia-esta-clave-secreta-en-produccion-min-32-bytes
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# Orígenes CORS permitidos (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000

# Proveedor LLM: "groq" o "openrouter"
LLM_PROVIDER=groq

# Clave de API para el proveedor seleccionado
GROQ_API_KEY=gsk_tu_clave_de_groq_aqui
OPENROUTER_API_KEY=sk-or-v1-tu_clave_de_openrouter_aqui

# Modelo a utilizar
# Para Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant
# Para OpenRouter: meta-llama/llama-3.3-70b-instruct, qwen/qwen-2.5-72b-instruct
LLM_MODEL=openai/gpt-oss-120b

# Configuración de Embeddings locales (FastEmbed multilingüe)
# Modelo de 384 dimensiones para compatibilidad exacta con VECTOR(384)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# Parámetros RAG
TOP_K=4
MAX_COSINE_DISTANCE=0.85
