# Configuración de Base de Datos PostgreSQL con extensión pgvector
DATABASE_URL=postgresql+asyncpg://tpi:tpi123@localhost:55432/isft189

# Proveedor LLM: "groq" o "openrouter"
LLM_PROVIDER=groq

# Clave de API para el proveedor seleccionado
GROQ_API_KEY=gsk_tu_clave_de_groq_aqui
OPENROUTER_API_KEY=sk-or-v1-tu_clave_de_openrouter_aqui

# Modelo a utilizar
# Para Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant
# Para OpenRouter: meta-llama/llama-3.3-70b-instruct, qwen/qwen-2.5-72b-instruct
LLM_MODEL=llama-3.3-70b-versatile

# Configuración de Embeddings locales (FastEmbed)
# Modelo de 384 dimensiones para compatibilidad exacta con VECTOR(384)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Parámetros RAG
TOP_K=4
MAX_COSINE_DISTANCE=0.85
