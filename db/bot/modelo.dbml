// Modelo — ISFT 189: Asistente Virtual Inteligente (Bot / RAG)
// Referencia al modelo institucional: la tabla de usuarios se comparte desde db/instituto

Project isft189_bot {
  database_type: 'PostgreSQL'
  Note: '''
    Módulo del Asistente Virtual Inteligente (RAG) para el ISFT 189.
    La autenticación y gestión de usuarios se delega al módulo institucional (instituto.usuario).
  '''
}

Enum tipo_documento {
  plan_estudio
  reglamento
  correlatividades
  resolucion
  otro
}

// Tabla institucional compartida (esquema instituto)
Table usuario {
  id bigint [pk, increment]
  nombre varchar(100) [not null]
  email varchar(150) [not null, unique]
  rol varchar(50) [not null]
  activo boolean [not null, default: true]

  Note: 'Referencia a la tabla `instituto.usuario` de la base institucional (ver db/instituto).'
}

Table documentos_metadata {
  id bigint [pk, increment]
  titulo varchar(200) [not null]
  tipo_documento tipo_documento [not null]
  fecha_subida timestamptz [not null, default: `now()`]
  carrera varchar(100)  // NULL si el documento es institucional
  activo boolean [not null, default: true]
}

Table historial_consultas {
  id bigint [pk, increment]
  usuario_id bigint [not null]
  pregunta text [not null]
  respuesta text [not null]
  fecha_consulta timestamptz [not null, default: `now()`]
}

// Próxima iteración: fragmentos vectorizados (pgvector)
Table documentos_vectoriales {
  id bigint [pk, increment]
  documento_id bigint [not null]
  contenido text [not null]
  metadata jsonb
  embedding vector
}

// Próxima iteración: relación N:M entre consultas y fragmentos utilizados como contexto
Table consulta_fragmentos {
  consulta_id bigint [not null]
  fragmento_id bigint [not null]

  indexes {
    (consulta_id, fragmento_id) [pk]
  }
}

// 1 usuario institucional genera N consultas en el asistente virtual
Ref: historial_consultas.usuario_id > usuario.id [delete: restrict, update: cascade]

// 1 documento origina N fragmentos
Ref: documentos_vectoriales.documento_id > documentos_metadata.id [delete: cascade]

// 1 consulta recupera N fragmentos
Ref: consulta_fragmentos.consulta_id > historial_consultas.id [delete: cascade]
Ref: consulta_fragmentos.fragmento_id > documentos_vectoriales.id [delete: cascade]
