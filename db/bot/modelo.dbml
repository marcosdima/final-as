// Modelo — ISFT 189: Asistente Virtual Inteligente (Bot / RAG)
// Base de datos vectorial y relacional para el servicio de asistencia académica

Project isft189_bot {
  database_type: 'PostgreSQL 16 (pgvector)'
  Note: '''
    Módulo del Asistente Virtual Inteligente (RAG) para el ISFT 189.
    Almacena metadatos documentales, fragmentos vectorizados con pgvector (384 dimensiones)
    e historial de consultas realizadas por los usuarios.
  '''
}

Enum tipo_documento {
  plan_estudio
  reglamento
  correlatividades
  resolucion
  otro
}

Table usuarios {
  id bigint [pk, increment]
  nombre varchar(100) [not null]
  email varchar(100) [not null, unique]
  rol varchar(20) [not null, default: 'ALUMNO']
  fecha_registro timestamptz [not null, default: `now()`]

  Note: 'Usuarios identificados para auditoría y personalización de consultas.'
}

Table documentos_metadata {
  id bigint [pk, increment]
  titulo varchar(200) [not null]
  tipo_documento tipo_documento [not null]
  fecha_subida timestamptz [not null, default: `now()`]
  carrera varchar(100)
  activo boolean [not null, default: true]

  indexes {
    tipo_documento [name: 'idx_documentos_tipo']
    carrera [name: 'idx_documentos_carrera']
  }

  Note: 'Registro de documentos oficiales cargados e indexados.'
}

Table documentos_vectoriales {
  id bigint [pk, increment]
  documento_id bigint [not null]
  contenido text [not null]
  metadata jsonb [not null, default: "'{}'::jsonb"]
  embedding "vector(384)" [not null]
  fecha_creacion timestamptz [not null, default: `now()`]

  indexes {
    documento_id [name: 'idx_vectoriales_documento_id']
    metadata [type: gin, name: 'idx_vectoriales_metadata_gin']
    embedding [type: 'hnsw (vector_cosine_ops)', name: 'idx_vectoriales_hnsw']
  }

  Note: 'Fragmentos de texto con embeddings semánticos e índice HNSW para similitud de coseno (<=>).'
}

Table historial_consultas {
  id bigint [pk, increment]
  usuario_id bigint [null]
  pregunta text [not null]
  respuesta text [not null]
  fecha_consulta timestamptz [not null, default: `now()`]

  indexes {
    usuario_id [name: 'idx_historial_usuario']
    fecha_consulta [name: 'idx_historial_fecha_consulta']
  }

  Note: 'Registro de preguntas de usuarios y respuestas generadas por el modelo de lenguaje.'
}

// Relaciones
Ref: documentos_vectoriales.documento_id > documentos_metadata.id [delete: cascade, update: cascade]
Ref: historial_consultas.usuario_id > usuarios.id [delete: set null, update: cascade]
