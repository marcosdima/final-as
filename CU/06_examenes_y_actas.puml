@startuml 06_examenes_y_actas

left to right direction
skinparam packageStyle rectangle
skinparam rectangle {
    BackgroundColor #FFFFFF
}

actor "Alumno/a" as alumno
actor "Preceptor/a" as preceptor
actor "Docente" as docente

rectangle "Exámenes Finales y Actas Oficiales" {
    usecase "CU-36: Programar mesa de examen final" as CU36
    usecase "CU-37: Inscribirse a examen final" as CU37
    usecase "CU-39: Validar condiciones para examen final" as CU39
    usecase "CU-38: Inscribir alumno/a a examen final fuera de término" as CU38
    usecase "CU-39: Validar condiciones para examen final" as CU39b
    usecase "CU-40: Anular inscripción a examen final" as CU40
    usecase "CU-41: Generar acta de examen" as CU41
    usecase "CU-42: Cargar calificaciones en acta de examen" as CU42
    usecase "CU-43: Cerrar acta de examen" as CU43
}

alumno --> CU37
alumno --> CU40

CU37 .> CU39 : <<include>>

preceptor --> CU36
preceptor --> CU38
preceptor --> CU41
preceptor --> CU43

CU38 .> CU39b : <<include>>

docente --> CU42

@enduml
