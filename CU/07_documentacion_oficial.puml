@startuml 07_documentacion_oficial

left to right direction
skinparam packageStyle rectangle
skinparam rectangle {
    BackgroundColor #FFFFFF
}

actor "Preceptor/a" as preceptor
actor "Usuario" as usuario

rectangle "Gestión Documental Institucional" {
    usecase "CU-44: Cargar plantilla de documento oficial" as CU44
    usecase "CU-45: Consultar plantillas de documentos oficiales" as CU45
}

preceptor --> CU44
usuario --> CU45

@enduml
